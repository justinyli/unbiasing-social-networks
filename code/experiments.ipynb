    "print(agg_unweighted.to_string())\n",
    "print(\"\\nVH-weighted rows, pop-weighted aggregate:\")\n",
    "print(agg_vh.to_string())\n",
    "print(\"\\nAlpha-weighted rows, pop-weighted aggregate:\")\n",
    "print(agg_weighted.to_string())\n",
